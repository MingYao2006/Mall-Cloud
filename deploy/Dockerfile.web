# 多阶段构建：编译两个前端（C端商城 + B端后台），产物打进 nginx 镜像
# 构建上下文 = 仓库根目录
FROM node:20-alpine AS build-c
WORKDIR /src
RUN npm config set registry https://registry.npmmirror.com
COPY mall-Project/mall-frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY mall-Project/mall-frontend/ ./
RUN npm run build

FROM node:20-alpine AS build-admin
WORKDIR /src
RUN npm config set registry https://registry.npmmirror.com
COPY mall-admin-frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY mall-admin-frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/mall.conf /etc/nginx/conf.d/mall.conf
COPY --from=build-c     /src/dist  /usr/share/nginx/html/c
COPY --from=build-admin /src/dist  /usr/share/nginx/html/admin
EXPOSE 80
