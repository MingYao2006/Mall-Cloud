# ============================================================
#  deploy/.env —— 复制成 .env 后填写真实值
#      cp .env.example .env
#  .env 已被 .gitignore 忽略，不会提交到 GitHub
#  权限建议：chmod 600 .env
# ============================================================

# ---------------- 必填 ----------------
# MySQL root 密码（只在数据卷首次初始化时生效，之后改这里不会改已建好的库）
MYSQL_PASSWORD=

# JWT 签名密钥：网关 / mall-Project / user-service / 管理端必须完全一致
# 生成：openssl rand -base64 48
JWT_SECRET=

# RabbitMQ 业务账号（必须新建用户，guest 只允许本机登录，容器之间连不上）
RABBITMQ_USER=mall
RABBITMQ_PASSWORD=

# Cloudflare Tunnel Token
# 获取：Cloudflare 面板 -> Zero Trust -> Networks -> Tunnels -> Create a tunnel
#       -> 选 Cloudflared -> 起名 mall -> 复制命令里 --token 后面那一串
TUNNEL_TOKEN=

# ---------------- 选填 ----------------
# 支付宝沙箱应用私钥（不用支付功能可以留空）
ALIPAY_PRIVATE_KEY=

# 支付宝应用公钥（与私钥成对，即上传到开放平台「接口加签方式」的那串）
ALIPAY_PUBLIC_KEY=

# 支付宝公钥（控制台「接口加签方式」页面展示的支付宝侧公钥，用于回调验签，勿与应用公钥搞混）
ALIPAY_ALIPAY_PUBLIC_KEY=

# 所有 Java 服务的默认最大堆；内存紧张调成 256m
JAVA_HEAP_MAX=320m

# Nacos 鉴权（只在内网，保持默认即可）
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=mallIdentity
NACOS_AUTH_IDENTITY_VALUE=mallIdentityValue
