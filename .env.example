# ============================================================
#  环境变量模板
#  用法：复制为 .env 后填写；或在 IDEA 运行配置里配置环境变量
#  真实密钥禁止写进源码 / 入库配置；
#  本地默认值放在各模块 src/main/resources/application-local.yaml
#  （该文件已被 .gitignore 忽略，不会提交）
# ============================================================

# ---------- JWT 签名密钥（必填；网关 / mall-Project / user-service / admin 必须一致）----------
# 生成命令：openssl rand -base64 48
JWT_SECRET=

# ---------- Spring Profile（默认 local）----------
SPRING_PROFILES_ACTIVE=local

# ---------- MySQL ----------
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---------- 支付宝沙箱（mall-Project / mall-payment-service）----------
# 重要：私钥一旦提交进 git 就必须到支付宝开放平台重新生成 RSA2 密钥对
ALIPAY_APP_ID=9021000167605065
ALIPAY_PRIVATE_KEY=

# ---------- 阿里云 OSS（mall-product-service，配置项 aliyun.oss.*）----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 微信小程序（mall-user-service，配置项 wechat.miniapp.*）----------
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# ---------- AI 导购 mall-ai-agent（完整变量见 mall-ai-agent/.env.example）----------
DEEPSEEK_API_KEY=
