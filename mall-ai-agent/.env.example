# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务
APP_HOST=0.0.0.0
APP_PORT=8095

# 回打商城网关（工具调用）
MALL_GATEWAY_BASE=http://localhost:9000/api/c
HTTP_TIMEOUT_SECONDS=15

# Redis 会话（阶段 4）
REDIS_URL=redis://localhost:6379/1
SESSION_MAX_MESSAGES=20
SESSION_SUMMARY_THRESHOLD=16

# Milvus / Embedding（阶段 3）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=mall_products
# 仅本地哈希兜底使用；远程 embedding 按接口返回维度自动探测
EMBEDDING_DIM=1024
# 可选：OpenAI 兼容 embedding；留空则使用本地哈希伪向量（开发可用）
# 硅基流动示例（BAAI/bge-large-zh-v1.5 为 1024 维）：
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35